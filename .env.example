# Kanonische Origin der Seite. Lokal leer lassen oder localhost setzen.
# Auf Vercel erst beim Domain-Cutover auf https://sunward.hr setzen —
# vorher greift automatisch die *.vercel.app-URL (siehe src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontaktformular (Phase 2). Web3Forms braucht keinen Servercode; der Access Key
# ist per Design öffentlich und steht im ausgelieferten HTML. Kein Secret.
NEXT_PUBLIC_WEB3FORMS_KEY=
