# Kanonische Origin der Seite. Lokal leer lassen oder localhost setzen.
# Auf Vercel erst beim Domain-Cutover auf https://sunward.hr setzen —
# vorher greift automatisch die *.vercel.app-URL (siehe src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Kontaktformular. Der Versand läuft über die API-Route /api/kontakt, also
# serverseitig — der Key gehört deshalb NICHT unter NEXT_PUBLIC_ und landet
# nicht im ausgelieferten HTML.
#
# Key auf web3forms.com anlegen; die Zieladresse (drvosped@gmail.com)
# wird dort einmalig per Klick im Postfach bestätigt. Ist der Key nicht
# gesetzt, antwortet die Route mit 503 und das Formular zeigt den
# mailto-Fallback — die Seite bleibt funktionsfähig.
WEB3FORMS_ACCESS_KEY=
